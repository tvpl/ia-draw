{
  "name": "architecture-canvas",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "backup:create": "node infra/backup/dist/cli/create.cli.js",
    "backup:verify": "node infra/backup/dist/cli/verify.cli.js",
    "backup:restore": "node infra/backup/dist/cli/restore.cli.js"
  },
  "devDependencies": {
    "@arch-canvas/repo-tools": "workspace:*",
    "@biomejs/biome": "^2.3.2",
    "@vitest/coverage-v8": "^3.2.4",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
