# Architecture Canvas — local compose environment
#
# cp .env.example .env
#
# Every value below is a CLEARLY INSECURE development default (they exist so
# `docker compose up --build` works out of the box on a clean machine).
#
# PRODUCTION MUST OVERRIDE EVERY SECRET BELOW. apps/server's loadConfig()
# refuses to boot in production (NODE_ENV=production) while SESSION_SECRET or
# ENCRYPTION_KEY are still "dev-insecure-secret-change-me" — it throws,
# naming the offending variable (FND-03). The same rule applies in spirit to
# POSTGRES_PASSWORD and MINIO_ROOT_PASSWORD: rotate them before any deployment
# that isn't purely local development.

NODE_ENV=development

# Public port the `proxy` service listens on (single entrypoint, product-spec §12).
PUBLIC_PORT=8080

# apps/server — session cookie signing / AES-256-GCM token encryption.
# INSECURE DEV DEFAULT — see apps/server/src/core/config.ts.
SESSION_SECRET=dev-insecure-secret-change-me
ENCRYPTION_KEY=dev-insecure-secret-change-me

# postgres
POSTGRES_USER=arch_canvas
POSTGRES_PASSWORD=dev-insecure-secret-change-me
POSTGRES_DB=arch_canvas

# minio
MINIO_ROOT_USER=arch-canvas-dev
MINIO_ROOT_PASSWORD=dev-insecure-secret-change-me
